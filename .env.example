# ---------------------------------------------------------------------------
# cupsponsor
# Everything here is optional. With none of it set the site still runs: bids go
# through in demo mode (no card, no hold) and view counts come from the local
# database. That is the mode to develop in.
# ---------------------------------------------------------------------------

# Stripe. Set both to take real bids. Bids are authorised, never charged, until
# the morning photo goes out — see docs in README.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the dashboard. Promotes a bid if the browser drops.
STRIPE_WEBHOOK_SECRET=

# Plausible. The script URL identifies the site all by itself in the newer
# format, and is inlined at build time — changing it needs a rebuild.
NEXT_PUBLIC_PLAUSIBLE_SRC=
# The rest is server-side, for reading the numbers back onto the page. Without
# them the page falls back to its own local hit counter.
PLAUSIBLE_SITE_ID=
PLAUSIBLE_API_KEY=
PLAUSIBLE_HOST=

# Molted (molted.email) — the outbid notification. Both must be set or the app
# simply never sends, which is the right behaviour locally.
MOLTED_API_KEY=
MOLTED_TENANT_ID=
# Optional, defaults to https://api.molted.email
MOLTED_BASE_URL=
# Used in the links inside those emails.
APP_BASE_URL=https://cup.junghard.com

# Guards POST /api/admin/capture, which takes the money from the standing hold.
ADMIN_TOKEN=

# Where the SQLite file lives. Defaults to ./data.
CUPSPONSOR_DATA_DIR=
